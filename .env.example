MONGODB_URI=
DB_ADI=sinav_sistemi
KOLEKSIYON=cevaps
# Upstash Redis TLS connection URL (rediss://default:...@...:6379).
# Upstash redis:// URLs are upgraded to rediss:// automatically; certificate verification stays enabled.
# If unavailable, FAQ lookups continue through MongoDB.
REDIS_URL=
# Use a random value of at least 32 characters; keep it private.
SESSION_SECRET=
# Internal FastAPI curriculum service; use the same long random token in both processes.
CURRICULUM_SERVICE_URL=http://127.0.0.1:8000
CURRICULUM_SERVICE_TOKEN=
# Optional dedicated MongoDB URI for isolated integration tests.
CURRICULUM_TEST_MONGODB_URI=
# Required to register teacher accounts. Share only with authorized teachers.
TEACHER_REGISTRATION_CODE=
# Google Identity Services Web client ID (OAuth 2.0); safe to expose as a public client ID.
GOOGLE_CLIENT_ID=
# Google AI Studio Gemini API key; keep this server-side and out of browser code.
GEMINI_API_KEY=
# SMTP settings used to deliver one-time password reset links.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# iyzico API credentials; never expose these in browser code.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# PayTR sandbox credentials; never expose these in browser code.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# Public HTTPS origin used for PayTR success/failure redirects (e.g. https://zarifcozum.com).
APP_BASE_URL=
# Server-to-Server OAuth application credentials (meeting:write:admin, user:read:admin)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# The Zoom host is fixed in lib/zoom.js, not configured through an environment variable.
# Separate Meeting SDK app credentials used to sign browser join tokens
# Cloudinary: ya tek parça CLOUDINARY_URL ya da aşağıdaki üç değişken (URL öncelikli).
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Admin site media: local (existing behavior) or r2. Do not use the student bucket.
# For r2, use a bucket-scoped R2 token with object read/write access. Keep the bucket private:
# public site media is served through the application. Existing local files are served first.
# Missing or invalid R2 configuration prevents startup; test before deploying.
SITE_MEDIA_STORAGE=local
R2_ACCOUNT_ID=
R2_MEDIA_BUCKET=
R2_MEDIA_ACCESS_KEY_ID=
R2_MEDIA_SECRET_ACCESS_KEY=
# Leave empty for a non-jurisdiction bucket, or use eu/us for the selected bucket.
R2_MEDIA_JURISDICTION=
