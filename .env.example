MONGODB_URI=
DB_ADI=sinav_sistemi
KOLEKSIYON=cevaps
# Use a random value of at least 32 characters; keep it private.
SESSION_SECRET=
# Required to register teacher accounts. Share only with authorized teachers.
TEACHER_REGISTRATION_CODE=
# Google AI Studio Gemini API key; keep this server-side and out of browser code.
AI_API_KEY=
# iyzico API credentials; never expose these in browser code.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# PayTR sandbox credentials; never expose these in browser code.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# Public HTTPS origin used for PayTR success/failure redirects (e.g. https://zarifcozum.com).
APP_BASE_URL=
# Server-to-Server OAuth application credentials (meeting:write:admin, user:read:admin)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Zoom user ID or email address that will host live lessons
ZOOM_HOST_USER_ID=
# Separate Meeting SDK app credentials used to sign browser join tokens
ZOOM_MEETING_SDK_CLIENT_ID=
ZOOM_MEETING_SDK_CLIENT_SECRET=
