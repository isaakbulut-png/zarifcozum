MONGODB_URI=
DB_ADI=sinav_sistemi
KOLEKSIYON=cevaps
# Use a random value of at least 32 characters; keep it private.
SESSION_SECRET=
# Required to register teacher accounts. Share only with authorized teachers.
TEACHER_REGISTRATION_CODE=
# Google Identity Services Web client ID (OAuth 2.0); safe to expose as a public client ID.
GOOGLE_CLIENT_ID=
# Google AI Studio Gemini API key; keep this server-side and out of browser code.
GEMINI_API_KEY=
# SMTP settings used to deliver one-time password reset links.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# iyzico API credentials; never expose these in browser code.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# PayTR sandbox credentials; never expose these in browser code.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# Public HTTPS origin used for PayTR success/failure redirects (e.g. https://zarifcozum.com).
APP_BASE_URL=
# Server-to-Server OAuth application credentials (meeting:write:admin, user:read:admin)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# The Zoom host is fixed in lib/zoom.js, not configured through an environment variable.
# Separate Meeting SDK app credentials used to sign browser join tokens
# Cloudinary: ya tek parça CLOUDINARY_URL ya da aşağıdaki üç değişken (URL öncelikli).
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
